---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
// About page content lives in this markdown file; edit it to change the page
import { Content } from '../content/Kumar_Gaurav_AI_Led_Transformation_Expert.md';

const title = 'About Me – Kumar Gaurav, AI-Led Transformation Expert';
const description =
	'Transformation delivery leader with 20+ years in large-scale modernization, agentic commerce and regulated legacy system transformation.';
---

