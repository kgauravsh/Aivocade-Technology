---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blogs / POVs</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<SocialLinks size={20} />
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links :global(a) {
		display: flex;
	}
	.social-links :global(a) {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		opacity: 0.75;
		transition: opacity 150ms;
	}
	.social-links :global(a:hover) {
		opacity: 1;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
	/* Phones: site name on its own line, nav links on one line below it */
	@media (max-width: 600px) {
		nav {
			flex-wrap: wrap;
		}
		h2 {
			width: 100%;
			padding-top: 0.75em;
		}
		h2 a {
			padding: 0.25em 0;
			border-bottom: 0;
		}
		.internal-links {
			display: flex;
			margin-left: -0.4em;
		}
		.internal-links :global(a) {
			padding: 0.5em 0.4em 0.6em;
			font-size: 0.9em;
			white-space: nowrap;
		}
	}
</style>
