    --surface: #fcfcfb;
    --surface-raised: #ffffff;
    --ink: #0b0b0b;
    --ink-2: #52514e;
    --muted: #898781;
    --grid: #e1e0d9;
    --axis: #c3c2b7;
    --border: rgba(11,11,11,0.10);
    --border-strong: rgba(11,11,11,0.18);
    --accent: #2a78d6;
    --accent-ink: #ffffff;
    --accent-soft: rgba(42,120,214,0.12);
    --accent-2: #eb6834;
    --accent-2-soft: rgba(235,104,52,0.12);
    --series-3: #1baf7a;
    --series-4: #eda100;
    --good: #0ca30c;
    --warning: #fab219;
    --serious: #ec835a;
    --critical: #d03b3b;
    --shadow: 0 1px 2px rgba(11,11,11,0.04), 0 8px 24px -12px rgba(11,11,11,0.12);
  }
  
  

  .il *{ box-sizing: border-box; }
  .il{
    background: var(--page);
    color: var(--ink);
    font-family: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    line-height: 1.55;
  }
  .il .mono{ font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace; }
  .il .tnum{ font-variant-numeric: tabular-nums; }

  .il .wrap{
    max-width: 980px;
    margin: 0 auto;
    padding: 28px 20px 80px;
  }

  /* ---------- Header ---------- */
