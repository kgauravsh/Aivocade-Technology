    box-shadow: 0 1px 2px rgba(0,0,0,0.3);
    transition: transform .15s ease;
  }
  .il .switch[aria-checked="true"]::after{ transform: translateX(20px); }
  .il .toggle-label{ font-size: 13.5px; font-weight: 500; }
  .il .toggle-label .mono{ color: var(--muted); font-size: 11.5px; }

  /* ---------- Segmented control ---------- */
  .il .segmented{
    display: inline-flex;
