  }

  /* ---------- Slider ---------- */
  .il .slider-wrap{ margin: 4px 0 4px; }
  .il input[type="range"]{
    -webkit-appearance: none;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: var(--grid);
    margin: 14px 0 6px;
  }
  .il input[type="range"]::-webkit-slider-thumb{
    -webkit-appearance: none;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--accent);
